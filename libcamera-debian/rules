#!/usr/bin/make -f

export DEB_CXXFLAGS_MAINT_APPEND = -O2

%:
	dh $@ --buildsystem=meson

override_dh_auto_configure:
	dh_auto_configure -- \
		--prefix=/usr \
		-Dpipelines=rpi/vc4,rpi/pisp \
		-Dipas=rpi/vc4,rpi/pisp \
		-Dv4l2=enabled \
		-Dgstreamer=enabled \
		-Dtest=false \
		-Dlc-compliance=disabled \
		-Dcam=enabled \
		-Dqcam=disabled \
		-Ddocumentation=disabled \
		-Dpycamera=enabled

override_dh_dwz:
	dh_dwz -Xlibcamera/ipa/

override_dh_strip:
	dh_strip -Xlibcamera/ipa/

override_dh_auto_test:
	# building with -Dtest=false already skips the test suites
